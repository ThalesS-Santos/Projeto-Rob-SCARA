<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scara">

  <xacro:arg name="is_sim" default="true"/>

  <xacro:include filename="$(find scara_description)/urdf/scara_gazebo.xacro" />
  <xacro:include filename="$(find scara_description)/urdf/scara_ros2_control.xacro" />

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="yellow">
    <color rgba="1 1 0 1"/>
  </material>

  <xacro:property name="PI" value="3.14159265359" />
  <xacro:property name="effort" value="30.0" />
  <xacro:property name="velocity" value="1.0" />

  <xacro:macro name="default_inertial" params="mass">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}" />
      <inertia ixx="1.0" ixy="0.0" ixz="0.0"
               iyy="1.0" iyz="0.0"
               izz="1.0" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="default_transmission" params="number">
    <transmission name="transmission_${number}">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="motor_${number}" role="actuator1"/>
      <joint name="joint_${number}" role="joint1">
        <mechanical_reduction>1.0</mechanical_reduction>
      </joint>
    </transmission>
  </xacro:macro>

  <link name="world"/>

  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:default_inertial mass="2.0"/>
    <visual>
      <origin rpy="0 0 ${PI}" xyz="0 0 0.15"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/bs.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 ${PI}" xyz="0 0 0.15"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/bs.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="es_link"/>
    <origin xyz="0 0 0.309" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${PI}" upper="${PI}" effort="${effort}" velocity="${velocity}"/>
  </joint>

  <link name="es_link">
    <xacro:default_inertial mass="0.5"/>
    <visual>
      <origin rpy="0 0 ${PI}" xyz="0.1 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/es.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 ${PI}" xyz="0.1 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/es.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="es_link"/>
    <child link="as_link"/>
    <origin xyz="0.2 0 0.078" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
  </joint>

  <link name="as_link">
    <xacro:default_inertial mass="0.5"/>
    <visual>
      <origin rpy="0 0 ${PI}" xyz="0.1062 0 0.049"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/as.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 ${PI}" xyz="0.1062 0 0.049"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/as.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_3" type="prismatic">
    <parent link="as_link"/>
    <child link="cs_link"/>
    <origin xyz="0.2562 0 0.049" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.22" upper="0" effort="${effort}" velocity="${velocity}"/>
  </joint>

  <link name="cs_link">
    <xacro:default_inertial mass="0.15"/>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/cs.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/cs.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="wrist_joint" type="revolute">
    <parent link="cs_link"/>
    <child link="g1_gripper"/>
    <origin xyz="0 0 -0.175" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
  </joint>

  <link name="g1_gripper">
    <xacro:default_inertial mass="0.1"/>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/g1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/g1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_joint1" type="prismatic">
    <parent link="g1_gripper"/>
    <child link="g2_gripper"/>
    <origin xyz="0.0195 0.010 -0.04175" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.015" effort="${effort}" velocity="0.1"/>
  </joint>

  <link name="g2_gripper">
    <xacro:default_inertial mass="0.02"/>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/g2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/g2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_joint2" type="prismatic">
    <parent link="g1_gripper"/>
    <child link="g3_gripper"/>
    <origin xyz="0.0195 -0.030 -0.04175" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.015" upper="0" effort="${effort}" velocity="0.1"/>
    <mimic joint="gripper_joint1" multiplier="-1" offset="0"/>
  </joint>

  <link name="g3_gripper">
    <xacro:default_inertial mass="0.02"/>
    <visual>
      <origin rpy="0 0 ${PI/2}" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/g3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 ${PI/2}" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://scara_description/meshes/g3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <xacro:default_transmission number="1"/>
  <xacro:default_transmission number="2"/>
  <xacro:default_transmission number="3"/>

</robot>
